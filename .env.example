# Demo app under test — AI QA Copilot (build bible §23)
PORT=4000

# Defect injection flags (0/1). Each maps 1:1 to a failure-taxonomy category (§16).
# DEFECT_LOCATOR_DRIFT=1  -> UI test-ids renamed/removed        (automation defect)
# DEFECT_API_500=1        -> POST /api/checkout returns 500     (product defect)
# DEFECT_FLAKY=1          -> random 300ms-3s API delays         (flaky behavior)
# DEFECT_BAD_DATA=1       -> orders returned without line items (test data defect)
DEFECT_LOCATOR_DRIFT=0
DEFECT_API_500=0
DEFECT_FLAKY=0
DEFECT_BAD_DATA=0
